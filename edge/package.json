{
  "name": "fastly-starter-kits-edge-service",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "Monorepo Edge Service serving manifest listings and tarball scaffolding streams",
  "main": "src/index.ts",
  "engines": {
    "node": ">=24"
  },
