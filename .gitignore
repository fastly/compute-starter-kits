# ==========================================
# System / OS Operational Files
# ==========================================
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db

# IDE / editor project settings
.idea/

# ==========================================
# Build Tool Scratch Paths
# ==========================================
# Safely ignores any remaining local staging paths if a build-kv tarball packaging step fails mid-loop
.temp-tarball-stage-*

# ==========================================
# Language Dependency & Package Directories
# ==========================================
# Catches node_modules at the root, inside tools/, edge/, and deep inside starter-kits/javascript/
**/node_modules/

# Python virtual environments and caches
**/.venv/
**/env/
**/venv/
**/ENV/
**/__pycache__/
**/*.pyc

# ==========================================
# Build Artifacts & Compiled Binaries
# ==========================================
# Fastly Compute local execution and packaging outputs
**/bin/
**/pkg/
**/.fastly/

# KV Store content
edge/test-data/

# Rust compilation targets
**/target/

# Go compiled binaries and test profiles
**/*.test
**/*.out

# ==========================================
# Local Environment Variables & Secrets
# ==========================================
# Prevents accidental leaks of live service IDs, tokens, or testing keys
.env
.env.*
!.env.example

# ==========================================
# Internal Working Documents
# ==========================================
# Design notes and planning docs kept alongside the repo but never published
.design/

# Per-developer Claude Code settings, plus any backup copies
# (shared skills under .claude/skills/ ARE tracked)
.claude/settings.local.json*
