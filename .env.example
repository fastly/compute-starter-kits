# Copy this file to .env (at the repo root) and fill in real values.
# .env is gitignored -- never commit real credentials.
#
# Used by tools/publish-kv to authenticate to the Fastly API and target
# the production KV store:
FASTLY_API_TOKEN=
FASTLY_KV_STORE_ID=

# Used when deploying the edge/ Compute service (e.g. `fastly compute deploy`)
# to target the correct Fastly service:
FASTLY_SERVICE_ID=
